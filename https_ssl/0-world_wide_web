#!/usr/bin/env bash
# Displays the DNS record type and destination of a domain's subdomains
audit_subdomain () {
    dig "$2.$1" | awk -v name="$2" '/ANSWER SECTION:/ { getline; print "The subdomain " name " is a " $4 " record and points to " $5 }'
}

if [ "$#" -eq 2 ]; then
    audit_subdomain "$1" "$2"
else
    for sub in www lb-01 web-01 web-02; do
        audit_subdomain "$1" "$sub"
    done
fi
